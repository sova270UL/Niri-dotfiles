#!/bin/bash
# niri-launcher - простой лаунчер без зависимостей
# Запускается через Mod+Alt+Space

echo "=== Niri Launcher ==="
echo "Выберите приложение (5 секунд на выбор):"

echo "1. Firefox"
echo "2. Kitty (терминал)"
echo "3. VS Code"
echo "4. Telegram"
echo "5. Thunar"
echo "6. Просмотрщик изображений"
echo "0. Отмена"

# Ожидание 5 секунд
for i in {1..5}; do
    read -t 1 -n 1 choice 2>/dev/null
    [ -n "$choice" ] && break
    echo -n "\rВремя: $((5 - i)) сек осталось "
done
echo ""

if [ "$choice" = "1" ]; then
    /usr/bin/firefox
elif [ "$choice" = "2" ]; then
    /usr/bin/kitty
elif [ "$choice" = "3" ]; then
    /usr/bin/code
elif [ "$choice" = "4" ]; then
    /usr/bin/telegram-desktop
elif [ "$choice" = "5" ]; then
    /usr/bin/thunar
elif [ "$choice" = "6" ]; then
    /usr/bin/eog
elif [ "$choice" = "0" ]; then
    echo "Отмена"
    exit 0
else
    echo "Время вышел, запускаем Firefox по умолчанию"
    /usr/bin/firefox
fi
