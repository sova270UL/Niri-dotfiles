{#- Токены: держать равными значениям из quickshell/niri/theme/Theme.qml -#}
{%- set font = "Noto Sans Mono 14" -%}
{%- set radius = 9 -%}
{%- set border = 2 -%}
{%- set gap = 7 -%}
{%- set ring = 2 -%}
{%- set padding = 12 -%}
{%- set bg_alpha = "d9" -%}
# Токены (Theme.qml): шрифт {{font}}, радиус {{radius}}, рамка {{border}}, отступ {{gap}}, кольцо {{ring}}
font={{font}}
background-color=#{{background | strip}}{{bg_alpha}}
text-color=#{{foreground | strip}}
border-color=#{{color4 | strip}}
border-size={{border}}
border-radius={{radius}}
padding={{padding}}
margin={{gap - ring}},{{gap}},{{gap}},{{gap}}
outer-margin=0
layer=overlay
anchor=top-right
max-visible=5
default-timeout=5000

icons=1
max-icon-size=48
icon-location=left
icon-border-radius={{radius}}

group-by=app-name
format=<b>%s</b>\n%b

[grouped=true]
format=<b>%s</b> (%g)\n%b

[urgency=low]
border-color=#{{color8 | strip}}
default-timeout=3000

[urgency=high]
border-color=#{{color1 | strip}}
default-timeout=0

[mode=dnd]
invisible=1

[mode=dnd urgency=high]
invisible=0
