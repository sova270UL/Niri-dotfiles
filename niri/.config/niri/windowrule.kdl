// Общее правило для окон
window-rule {
    geometry-corner-radius 9
    clip-to-geometry true
    draw-border-with-background false
}

// Общая прозрачность
window-rule {
    match is-active=false
    opacity 0.85
}

window-rule {
    match app-id="firefox"
    opacity 1.0
    // Размытие под прозрачной оболочкой Firefox (userChrome.css)
    background-effect {
        blur true
    }
}

// PiP для firefox
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// Kitty
window-rule {
    match app-id="^kitty$"
    match app-id="^yazi$"

    background-effect {
        blur true
    }
    draw-border-with-background false
}

window-rule {
    match app-id="dev.zed.Zed"

    opacity 1.0
}

window-rule {
    match app-id="^nmtui$"
    open-floating true
}

// Satty: правка скриншотов (бинт Mod+Print)
window-rule {
    match app-id="org.satty.satty"
    open-floating true
}

//iiko
window-rule {
	match app-id="backoffice.exe"
	match app-id="aspia_client.exe"
	default-column-width { proportion 1.0; }
}

// Mango Talker / BackOffice: виртуальный рабочий стол Wine.
// Окно "… — Рабочий стол Wine" тайлится, как обычное (размер задаёт CLEAR.py:
// по умолчанию 1868x1037 — как тайловая область экрана 1920x1080).
// Матчим только app-id: у Wine заголовок появляется после открытия окна.
window-rule {
    match app-id=r#"^explorer\.exe$"#
    open-floating false
    // Wine-десктоп фиксированного размера (1868x1037): колонка — во всю ширину,
    // иначе niri отдаёт новому окну половину и содержимое обрезается.
    default-column-width { proportion 1.0; }
    // Wine в desktop-режиме просит fullscreen, если размер десктопа совпал
    // с экраном; страховка, чтобы окно не разворачивалось.
    open-fullscreen false
}
