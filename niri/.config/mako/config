# Токены (Theme.qml): шрифт Noto Sans Mono 14, радиус 9, рамка 2, отступ 7, кольцо 2
font=Noto Sans Mono 14
background-color=#1F1F21d9
text-color=#F9F9FA
border-color=#A07ABF
border-size=2
border-radius=9
padding=12
margin=5,7,7,7
outer-margin=0
layer=overlay
anchor=top-right
max-visible=5
default-timeout=5000

icons=1
max-icon-size=48
icon-location=left
icon-border-radius=9

group-by=app-name
format=<b>%s</b>\n%b

[grouped=true]
format=<b>%s</b> (%g)\n%b

[urgency=low]
border-color=#A7A7A8
default-timeout=3000

[urgency=high]
border-color=#4F4F56
default-timeout=0

[mode=dnd]
invisible=1

[mode=dnd urgency=high]
invisible=0
